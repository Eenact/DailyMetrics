<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/DashboardFragment">

    <fragment
        android:id="@+id/DashboardFragment"
        android:name="com.softtechno.tasktracker.gui.fragments.DashboardFragment"
        android:label="@string/dashboard_fragment_label"
        tools:layout="@layout/fragment_dashboard">

        <action
            android:id="@+id/action_DashboardFragment_to_TaskFragment"
            app:destination="@id/TaskFragment"
            app:popUpToSaveState="true"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim"/>

        <action
            android:id="@+id/action_DashboardFragment_to_TaskEntryFragment"
            app:destination="@id/TaskEntryFragment"
            app:popUpToSaveState="true"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim"/>
    </fragment>
    <fragment
        android:id="@+id/TaskFragment"
        android:name="com.softtechno.tasktracker.gui.fragments.TaskFragment"
        android:label="@string/task_fragment_label"
        tools:layout="@layout/fragment_task">

        <action
            android:id="@+id/action_TaskFragment_to_DashboardFragment"
            app:destination="@id/DashboardFragment"
            app:popUpTo="@+id/DashboardFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim"/>
    </fragment>

    <fragment
        android:id="@+id/TaskEntryFragment"
        android:name="com.softtechno.tasktracker.gui.fragments.TaskEntryDialogFragment"
        android:label="@string/task_entry_fragment_label"
        tools:layout="@layout/fragment_entry">

        <action
            android:id="@+id/action_TaskEntryFragment_to_DashboardFragment"
            app:destination="@id/DashboardFragment"
            app:popUpTo="@+id/DashboardFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim"/>

    </fragment>
</navigation>