<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="24dp">

    <ImageView
        android:id="@+id/adapter_export_item_image_view"
        android:layout_width="@dimen/export_list_image_size"
        android:layout_height="@dimen/export_list_image_size"
        android:contentDescription="@string/export_list_image_view_desc"
        android:src="@drawable/ic_share"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/adapter_export_item_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:text="@string/export_share_list"
        android:textSize="@dimen/export_list_text_size"
        app:layout_constraintBottom_toBottomOf="@id/adapter_export_item_image_view"
        app:layout_constraintLeft_toRightOf="@id/adapter_export_item_image_view"
        app:layout_constraintTop_toTopOf="@id/adapter_export_item_image_view" />

</androidx.constraintlayout.widget.ConstraintLayout>