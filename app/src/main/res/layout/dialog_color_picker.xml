<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <GridView
        android:id="@+id/color_pick_grid_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawSelectorOnTop="true"
        android:gravity="center"
        android:horizontalSpacing="5dp"
        android:numColumns="3"
        android:stretchMode="columnWidth"
        android:verticalSpacing="5dp"
        app:layout_constraintBottom_toTopOf="@+id/color_pick_random_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/color_pick_random_btn"
        style="@style/Widget.Material3.Button.ElevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/dialog_color_pick_random"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/theme_white"
        app:backgroundTint="@color/colorPrimary"
        app:layout_constraintEnd_toStartOf="@+id/color_pick_preview_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/color_pick_grid_view" />

    <ImageView
        android:id="@+id/color_pick_preview_view"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:background="@color/legend_red"
        android:contentDescription="@string/dialog_color_pick_title"
        app:layout_constraintBottom_toBottomOf="@+id/color_pick_random_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/color_pick_random_btn"
        app:layout_constraintTop_toTopOf="@+id/color_pick_random_btn" />

</androidx.constraintlayout.widget.ConstraintLayout>